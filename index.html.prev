<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>羿学交易 - 智囊团仪表盘</title>
    <link rel="stylesheet" href="css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="header">
            <div class="logo">
                <span class="logo-icon">📊</span>
                <h1>羿学交易 <span class="subtitle">智囊团仪表盘</span></h1>
            </div>
            <div class="header-right">
                <span class="date" id="current-date">2026-03-23</span>
                <span class="status-dot"></span>
            </div>
        </header>

        <!-- Navigation -->
        <nav class="nav-tabs">
            <button class="tab-btn active" data-tab="news">
                <span class="tab-icon">📰</span>
                每日情报
            </button>
            <button class="tab-btn" data-tab="gap">
                <span class="tab-icon">🔍</span>
                预期差清单
            </button>
            <button class="tab-btn" data-tab="qimen">
                <span class="tab-icon">☯️</span>
                奇门预测
            </button>
            <button class="tab-btn" data-tab="stocks">
                <span class="tab-icon">📈</span>
                选股报告
            </button>
            <button class="tab-btn" data-tab="market">
                <span class="tab-icon">🌐</span>
                市场概览
            </button>
            <button class="tab-btn" data-tab="team">
                <span class="tab-icon">👥</span>
                智囊团
            </button>
        </nav>

        <!-- Main Content -->
        <main class="main-content">
            
            <!-- Tab: Daily News -->
            <section id="news" class="tab-content active">
                <div class="section-header">
                    <h2>📰 每日情报汇总 (2026-03-20)</h2>
                    <button class="refresh-btn" onclick="refreshNews()">🔄 刷新</button>
                </div>
                
                <div class="news-grid">
                    <!-- Market Overview Card -->
                    <div class="news-card highlight">
                        <div class="card-header">
                            <h3>📊 大盘行情</h3>
                            <span class="time">收盘</span>
                        </div>
                        <div class="market-brief">
                            <div class="index-item down">
                                <span class="index-name">上证指数</span>
                                <span class="index-value">3,957.00</span>
                                <span class="index-change">-1.24% 🔴</span>
                            </div>
                            <div class="index-item down">
                                <span class="index-name">深证成指</span>
                                <span class="index-value">-</span>
                                <span class="index-change">-0.25%</span>
                            </div>
                            <div class="index-item up">
                                <span class="index-name">创业板指</span>
                                <span class="index-value">-</span>
                                <span class="index-change">+1.30% 🟢</span>
                            </div>
                            <div class="market-summary">
                                <p>成交额：<strong>2.30万亿</strong> | 涨跌比：<strong>约1:4</strong>（超4700只下跌）</p>
                                <p>沪指失守4000点，创年内新低；创业板指逆势收涨</p>
                            </div>
                        </div>
                    </div>

                    <!-- Policy News -->
                    <div class="news-card">
                        <div class="card-header">
                            <h3>🏛️ 政策要闻</h3>
                            <span class="badge">3条</span>
                        </div>
                        <ul class="news-list">
                            <li>
                                <span class="news-tag policy">央行</span>
                                <a href="#">央行：坚定维护金融市场平稳运行，研究建立对非银机构流动性支持机制</a>
                                <span class="news-time">18日</span>
                            </li>
                            <li>
                                <span class="news-tag policy">证监会</span>
                                <a href="#">吴清召集五大类投资机构座谈会，明确A股资金端支持方向</a>
                                <span class="news-time">20日</span>
                            </li>
                            <li>
                                <span class="news-tag policy">山西</span>
                                <a href="#">发布重点产业链能级跃升计划，目标营收8000亿元</a>
                                <span class="news-time">20日</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Global Macro -->
                    <div class="news-card">
                        <div class="card-header">
                            <h3>🌍 全球宏观</h3>
                            <span class="badge alert">地缘风险</span>
                        </div>
                        <ul class="news-list">
                            <li>
                                <span class="news-tag macro">美联储</span>
                                <a href="#">维持利率不变，点阵图削减年内降息至1次，上调通胀预期</a>
                                <span class="news-time">鹰派</span>
                            </li>
                            <li>
                                <span class="news-tag macro">中东</span>
                                <a href="#">伊朗反击沙特、卡塔尔能源设施，多方介入局势复杂化</a>
                                <span class="news-time">升级</span>
                            </li>
                            <li>
                                <span class="news-tag macro">央行周</span>
                                <a href="#">英欧日央行均维持利率不变，全球央行同步转谨慎</a>
                                <span class="news-time">观望</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Sector Rotation -->
                    <div class="news-card">
                        <div class="card-header">
                            <h3>🔥 板块表现</h3>
                            <span class="badge">分化</span>
                        </div>
                        <div class="sector-list">
                            <div class="sector-item up strong">
                                <span class="sector-name">光伏设备</span>
                                <span class="sector-change">+3.5%</span>
                            </div>
                            <div class="sector-item up strong">
                                <span class="sector-name">能源金属</span>
                                <span class="sector-change">+2.8%</span>
                            </div>
                            <div class="sector-item up">
                                <span class="sector-name">电池</span>
                                <span class="sector-change">+2.1%</span>
                            </div>
                            <div class="sector-item down">
                                <span class="sector-name">算力租赁</span>
                                <span class="sector-change">-3.2%</span>
                            </div>
                            <div class="sector-item down">
                                <span class="sector-name">AI应用</span>
                                <span class="sector-change">-2.8%</span>
                            </div>
                            <div class="sector-item down">
                                <span class="sector-name">机器人</span>
                                <span class="sector-change">-2.5%</span>
                            </div>
                        </div>
                    </div>

                    <!-- Commodities -->
                    <div class="news-card">
                        <div class="card-header">
                            <h3>📉 大宗商品</h3>
                            <span class="badge">波动</span>
                        </div>
                        <div class="sector-list">
                            <div class="sector-item down">
                                <span class="sector-name">COMEX黄金</span>
                                <span class="sector-change">-4.99%</span>
                            </div>
                            <div class="sector-item down">
                                <span class="sector-name">COMEX白银</span>
                                <span class="sector-change">-6.16%</span>
                            </div>
                            <div class="sector-item down">
                                <span class="sector-name">LME铝</span>
                                <span class="sector-change">-5.19%</span>
                            </div>
                            <div class="sector-item neutral">
                                <span class="sector-name">布伦特原油</span>
                                <span class="sector-change">冲高回落</span>
                            </div>
                        </div>
                    </div>

                    <!-- Institutional Views -->
                    <div class="news-card wide">
                        <div class="card-header">
                            <h3>🏢 机构观点</h3>
                            <span class="badge">最新</span>
                        </div>
                        <table class="institution-table">
                            <thead>
                                <tr>
                                    <th>机构</th>
                                    <th>核心观点</th>
                                    <th>推荐方向</th>
                                    <th>评级</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>华泰证券</strong></td>
                                    <td>地缘冲突与政策底博弈，短期震荡筑底</td>
                                    <td>内需+自主可控</td>
                                    <td><span class="rating neutral">中性</span></td>
                                </tr>
                                <tr>
                                    <td><strong>中金公司</strong></td>
                                    <td>A股投资机会仍存，AI革命距整体破裂尚远</td>
                                    <td>AI产业链</td>
                                    <td><span class="rating buy">看多</span></td>
                                </tr>
                                <tr>
                                    <td><strong>中信证券</strong></td>
                                    <td>红利风格维持高胜率，自由现金流改善板块</td>
                                    <td>高股息红利</td>
                                    <td><span class="rating buy">看多</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- Tab: Expectation Gap -->
            <section id="gap" class="tab-content">
                <div class="section-header">
                    <h2>🔍 预期差清单</h2>
                    <span class="update-time">更新时间：2026-03-20 20:30</span>
                </div>

                <div class="gap-list">
                    <!-- Gap Item 1 -->
                    <div class="gap-card rank-1">
                        <div class="gap-header">
                            <span class="rank">🥇</span>
                            <h3>光伏/锂电板块修复</h3>
                            <span class="gap-size">预期差：中偏大</span>
                        </div>
                        <div class="gap-body">
                            <table class="gap-table">
                                <tr>
                                    <th>维度</th>
                                    <th>市场假设</th>
                                    <th>实际情况</th>
                                </tr>
                                <tr>
                                    <td>需求端</td>
                                    <td>Q2需求平淡，旺季在Q3</td>
                                    <td>抢装潮提前+海外需求超预期</td>
                                </tr>
                                <tr>
                                    <td>供给端</td>
                                    <td>产能过剩，价格战持续</td>
                                    <td>小企业出清，龙头开工率回升</td>
                                </tr>
                                <tr>
                                    <td>估值端</td>
                                    <td>便宜有便宜的道理</td>
                                    <td>政策催化+价格企稳，修复逻辑成立</td>
                                </tr>
                            </table>
                            <div class="gap-action">
                                <span class="target">标的：光伏组件龙头、锂电材料龙头</span>
                                <span class="strategy">策略：回调低吸，不宜追高</span>
                                <span class="verify">验证：下周组件价格数据</span>
                            </div>
                        </div>
                    </div>

                    <!-- Gap Item 2 -->
                    <div class="gap-card rank-2">
                        <div class="gap-header">
                            <span class="rank">🥈</span>
                            <h3>央行政策底确认</h3>
                            <span class="gap-size">预期差：中</span>
                        </div>
                        <div class="gap-body">
                            <table class="gap-table">
                                <tr>
                                    <th>维度</th>
                                    <th>市场假设</th>
                                    <th>实际情况</th>
                                </tr>
                                <tr>
                                    <td>政策力度</td>
                                    <td>口头表态为主</td>
