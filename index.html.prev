                            <div class="gap-action">
                                <span class="target">标的：高股息蓝筹、金融ETF</span>
                                <span class="strategy">策略：恐慌性下跌时布局</span>
                                <span class="verify">验证：3月21日LPR报价</span>
                            </div>
                        </div>
                    </div>

                    <!-- Gap Item 3 -->
                    <div class="gap-card rank-3">
                        <div class="gap-header">
                            <span class="rank">🥉</span>
                            <h3>富时A50新纳入标的</h3>
                            <span class="gap-size">预期差：小中</span>
                        </div>
