                <div class="qimen-dashboard">
                    <!-- Overall Rating -->
                    <div class="qimen-overview">
                        <div class="rating-card">
                            <h3>大势评级</h3>
                            <div class="rating-stars">★★☆☆☆</div>
                            <p class="rating-text">震荡偏弱，上有压力</p>
