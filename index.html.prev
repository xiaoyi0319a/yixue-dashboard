                                    <td>值符+天冲，冲动之象</td>
                                    <td>🟢 地缘催化</td>
                                    <td>逢低关注</td>
                                </tr>
                                <tr class="weak">
                                    <td>科技（AI/半导体）</td>
                                    <td>兑宫白虎干格，惊门临宫</td>
                                    <td>🔴 继续承压</td>
                                    <td>回避为主</td>
                                </tr>
                                <tr class="weak">
                                    <td>金融</td>
                                    <td>乾宫刑格，开门受制</td>
                                    <td>🔴 护盘但阻力大</td>
                                    <td>观望</td>
                                </tr>
                                <tr class="neutral">
                                    <td>医药</td>
                                    <td>天芮临坤，病星得地</td>
                                    <td>🟡 防御属性</td>
                                    <td>抗跌配置</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Timing -->
                    <div class="qimen-timing">
                        <h3>时辰吉凶参考</h3>
                        <div class="time-slots">
                            <div class="slot">
                                <span class="time">09:30-10:30</span>
                                <span class="prediction">若高开防冲高回落</span>
                            </div>
                            <div class="slot">
                                <span class="time">11:00-13:00</span>
                                <span class="prediction">盘中波动最大时段</span>
                            </div>
                            <div class="slot">
                                <span class="time">14:00后</span>
                                <span class="prediction">尾盘方向选择</span>
                            </div>
                        </div>
                    </div>

                    <!-- Strategy -->
                    <div class="qimen-strategy">
                        <h3>操作策略</h3>
                        <div class="strategy-cards">
                            <div class="strategy-card">
